@model IEnumerable<AdministradorBliblioteca.Models.Libro>
@{
    ViewData["Title"] = "Lista de Libros";
}

<h2 class="mt-3 mb-4 text-center text-primary">Gestor de Libros (MySQL + EF Core 10)</h2>
<p>
    <a asp-action="Crear" class="btn btn-success">+ Nuevo Libro</a>
</p>
<table class="table table-bordered table-striped table-hover mt-3">
    <thead class="table-dark text-center">
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Titulo)</th>
            <th>@Html.DisplayNameFor(model => model.First().Autor)</th>
            <th>@Html.DisplayNameFor(model => model.First().AnioPublicacion)</th>
            <th>@Html.DisplayNameFor(model => model.First().Precio)</th>
            <th>@Html.DisplayNameFor(model => model.First().Disponible)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Titulo</td>
                    <td>@item.Autor</td>
                    <td>@item.AnioPublicacion</td>
                    <td>@item.Precio.ToString("N2")</td>
                    <td>
                        @if (item.Disponible)
                        {
                            <span class="badge bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No Disponible</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detalles</a>
                        <a asp-action="Borrar" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Borrar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No hay libros disponibles.</td>
            </tr>
        }
    </tbody>
</table>
