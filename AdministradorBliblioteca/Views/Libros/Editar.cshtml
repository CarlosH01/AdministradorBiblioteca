@model AdministradorBliblioteca.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<h2 class="mt-4 mb-3 text-center text-primary">Editar Libro</h2>
<hr />
<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-action="Editar" method="POST" class="card p-4 shadow-sm">
            <!--Identificador oculto-->
            <input type="hidden" asp-for="Id" />

            <!--Muestra errores generales-->
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label fw-bold"></label>
                <input asp-for="Titulo" class="form-control" placeholder="Ej: Meditaciones" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Autor" class="form-label fw-bold"></label>
                <input asp-for="Autor" class="form-control" placeholder="Ej: Marco Aurelio" />
                <span asp-validation-for="Autor" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="AnioPublicacion" class="form-label fw-bold"></label>
                <input asp-for="AnioPublicacion" class="form-control" type="number" placeholder="Ej:2026" />
                <span asp-validation-for="AnioPublicacion" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Precio" class="form-label fw-bold"></label>
                <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="Ej: 99.99" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>
            <div class="form-check mt-3">
                <input asp-for="Disponible" class="form-check-input">
                <label asp-for="Disponible" class="form-check-label"></label>
            </div>
            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
                <button type="submit" class="btn btn-success">Editar Libro</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}